node_modules/

# Local credentials. Jujutsu snapshots every non-ignored file into the working
# copy commit automatically, so an unignored .env is one `jj commit` away from
# being published in a public repository.
.env
.env.*
!.env.example

# Local review run artifacts and incremental state written by `shuvbot review`
.shuvbot/

# Compiled local CLI executable
bin/shuvbot
