{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shuvbot-dashboard",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuvbot-dashboard",
      "database_id": "f38d6ea3-0787-4f2c-bb3c-fddb93cf620b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
