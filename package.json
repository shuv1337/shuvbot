{
  "name": "reviewbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "reviewbot": "./packages/cli/src/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "release": "bun scripts/release.ts",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "evals": "bun packages/evals/src/harness.ts",
    "smoke:runtime": "bun scripts/runtime-compat-smoke.ts",
    "dogfood:review": "bun packages/cli/src/index.ts review --engine coordinator",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "smol-toml": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/bun": "^1.2.13",
    "shuvcode": "2.0.0-alpha-9",
    "@types/node": "^22.15.19",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
